{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://schemas.dharma-ai.io/local-signing-maintenance-upgrade/v1",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema", "upgradeId", "organizationId", "deviceId", "workspaceId", "version", "previousVersion", "state", "upgradeComplete", "runtimeObservation", "ready", "nativeContinuationAuthorized", "priorJournalArchive", "priorJournalSha256", "createdAt"],
  "properties": {
    "schema": {"const": "dharma.local-signing-maintenance-upgrade/v1"},
    "upgradeId": {"type": "string", "format": "uuid"},
    "organizationId": {"type": "string", "pattern": "^[A-Za-z0-9][A-Za-z0-9_-]{0,199}$"},
    "deviceId": {"type": "string", "format": "uuid"},
    "workspaceId": {"type": "string", "format": "uuid"},
    "version": {"type": "string", "maxLength": 64, "pattern": "^[0-9]+\\.[0-9]+\\.[0-9]+(?:-[A-Za-z0-9.-]+)?$"},
    "previousVersion": {"type": "string", "maxLength": 64, "pattern": "^[0-9]+\\.[0-9]+\\.[0-9]+(?:-[A-Za-z0-9.-]+)?$"},
    "state": {"enum": ["planned", "prepared", "staged", "finishing", "completed", "staging_reverted", "staging_failed", "finish_failed"]},
    "upgradeComplete": {"type": "boolean"},
    "runtimeObservation": {"enum": ["not_performed", "unconfirmed", "local_process_and_poll"]},
    "ready": {"const": false},
    "nativeContinuationAuthorized": {"const": false},
    "priorJournalArchive": {"type": ["string", "null"], "pattern": "^runtime-upgrade\\.[a-f0-9-]{36}\\.[a-f0-9]{64}\\.history\\.json$"},
    "priorJournalSha256": {"type": ["string", "null"], "pattern": "^sha256:[a-f0-9]{64}$"},
    "createdAt": {"type": "string", "format": "date-time"}
  },
  "allOf": [
    {"if": {"properties": {"state": {"const": "completed"}}},
      "then": {"properties": {"upgradeComplete": {"const": true}, "runtimeObservation": {"const": "local_process_and_poll"}}},
      "else": {"properties": {"upgradeComplete": {"const": false}}}},
    {"if": {"properties": {"state": {"enum": ["planned", "prepared", "staged", "staging_reverted"]}}},
      "then": {"properties": {"runtimeObservation": {"const": "not_performed"}}}},
    {"if": {"properties": {"state": {"enum": ["finishing", "staging_failed", "finish_failed"]}}},
      "then": {"properties": {"runtimeObservation": {"const": "unconfirmed"}}}}
  ]
}
