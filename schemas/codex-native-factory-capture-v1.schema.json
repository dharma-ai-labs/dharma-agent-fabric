{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "properties": {
    "factoryTaskId": {
      "type": "string",
      "pattern": "^[A-Za-z0-9_-]{1,128}$"
    },
    "parentThreadId": {
      "type": "string",
      "pattern": "^[A-Za-z0-9_-]{1,128}$"
    },
    "parentTurnId": {
      "type": "string",
      "pattern": "^[A-Za-z0-9_-]{1,128}$"
    },
    "childThreadId": {
      "type": "string",
      "pattern": "^[A-Za-z0-9_-]{1,128}$"
    },
    "organizationId": {
      "anyOf": [
        {
          "type": "string",
          "pattern": "^[A-Za-z0-9_-]{1,128}$"
        },
        {
          "type": "null"
        }
      ]
    },
    "workspace": {
      "type": "string",
      "minLength": 1,
      "maxLength": 4096
    },
    "instructionHash": {
      "type": "string",
      "pattern": "^sha256:[a-f0-9]{64}$"
    },
    "scope": {
      "type": "object",
      "properties": {
        "readPaths": {
          "maxItems": 64,
          "type": "array",
          "items": {
            "type": "string",
            "minLength": 1,
            "maxLength": 4096
          }
        },
        "writePaths": {
          "maxItems": 64,
          "type": "array",
          "items": {
            "type": "string",
            "minLength": 1,
            "maxLength": 4096
          }
        },
        "tools": {
          "minItems": 1,
          "maxItems": 32,
          "type": "array",
          "items": {
            "type": "string",
            "pattern": "^[A-Za-z0-9_-]{1,128}$"
          }
        },
        "startedAt": {
          "type": "string",
          "format": "date-time",
          "pattern": "^(?:(?:\\d\\d[2468][048]|\\d\\d[13579][26]|\\d\\d0[48]|[02468][048]00|[13579][26]00)-02-29|\\d{4}-(?:(?:0[13578]|1[02])-(?:0[1-9]|[12]\\d|3[01])|(?:0[469]|11)-(?:0[1-9]|[12]\\d|30)|(?:02)-(?:0[1-9]|1\\d|2[0-8])))T(?:(?:[01]\\d|2[0-3]):[0-5]\\d:[0-5]\\d(?:\\.\\d+)?(?:Z))$"
        },
        "expiresAt": {
          "type": "string",
          "format": "date-time",
          "pattern": "^(?:(?:\\d\\d[2468][048]|\\d\\d[13579][26]|\\d\\d0[48]|[02468][048]00|[13579][26]00)-02-29|\\d{4}-(?:(?:0[13578]|1[02])-(?:0[1-9]|[12]\\d|3[01])|(?:0[469]|11)-(?:0[1-9]|[12]\\d|30)|(?:02)-(?:0[1-9]|1\\d|2[0-8])))T(?:(?:[01]\\d|2[0-3]):[0-5]\\d:[0-5]\\d(?:\\.\\d+)?(?:Z))$"
        },
        "maximumChildTurns": {
          "type": "integer",
          "minimum": 1,
          "maximum": 32
        },
        "maximumUsd": {
          "anyOf": [
            {
              "type": "number",
              "minimum": 0,
              "maximum": 100
            },
            {
              "type": "null"
            }
          ]
        }
      },
      "required": [
        "readPaths",
        "writePaths",
        "tools",
        "startedAt",
        "expiresAt",
        "maximumChildTurns",
        "maximumUsd"
      ],
      "additionalProperties": false
    },
    "events": {
      "minItems": 1,
      "maxItems": 128,
      "type": "array",
      "items": {
        "anyOf": [
          {
            "type": "object",
            "properties": {
              "eventId": {
                "type": "string",
                "pattern": "^[A-Za-z0-9_-]{1,128}$"
              },
              "at": {
                "type": "string",
                "format": "date-time",
                "pattern": "^(?:(?:\\d\\d[2468][048]|\\d\\d[13579][26]|\\d\\d0[48]|[02468][048]00|[13579][26]00)-02-29|\\d{4}-(?:(?:0[13578]|1[02])-(?:0[1-9]|[12]\\d|3[01])|(?:0[469]|11)-(?:0[1-9]|[12]\\d|30)|(?:02)-(?:0[1-9]|1\\d|2[0-8])))T(?:(?:[01]\\d|2[0-3]):[0-5]\\d:[0-5]\\d(?:\\.\\d+)?(?:Z))$"
              },
              "actor": {
                "type": "string",
                "enum": [
                  "parent",
                  "child"
                ]
              },
              "payloadHash": {
                "type": "string",
                "pattern": "^sha256:[a-f0-9]{64}$"
              },
              "kind": {
                "type": "string",
                "enum": [
                  "spawn",
                  "message",
                  "checkpoint",
                  "output"
                ]
              }
            },
            "required": [
              "eventId",
              "at",
              "actor",
              "payloadHash",
              "kind"
            ],
            "additionalProperties": false
          },
          {
            "type": "object",
            "properties": {
              "eventId": {
                "type": "string",
                "pattern": "^[A-Za-z0-9_-]{1,128}$"
              },
              "at": {
                "type": "string",
                "format": "date-time",
                "pattern": "^(?:(?:\\d\\d[2468][048]|\\d\\d[13579][26]|\\d\\d0[48]|[02468][048]00|[13579][26]00)-02-29|\\d{4}-(?:(?:0[13578]|1[02])-(?:0[1-9]|[12]\\d|3[01])|(?:0[469]|11)-(?:0[1-9]|[12]\\d|30)|(?:02)-(?:0[1-9]|1\\d|2[0-8])))T(?:(?:[01]\\d|2[0-3]):[0-5]\\d:[0-5]\\d(?:\\.\\d+)?(?:Z))$"
              },
              "actor": {
                "type": "string",
                "enum": [
                  "parent",
                  "child"
                ]
              },
              "payloadHash": {
                "type": "string",
                "pattern": "^sha256:[a-f0-9]{64}$"
              },
              "kind": {
                "type": "string",
                "const": "recovery"
              },
              "checkpointId": {
                "type": "string",
                "pattern": "^[A-Za-z0-9_-]{1,128}$"
              }
            },
            "required": [
              "eventId",
              "at",
              "actor",
              "payloadHash",
              "kind",
              "checkpointId"
            ],
            "additionalProperties": false
          },
          {
            "type": "object",
            "properties": {
              "eventId": {
                "type": "string",
                "pattern": "^[A-Za-z0-9_-]{1,128}$"
              },
              "at": {
                "type": "string",
                "format": "date-time",
                "pattern": "^(?:(?:\\d\\d[2468][048]|\\d\\d[13579][26]|\\d\\d0[48]|[02468][048]00|[13579][26]00)-02-29|\\d{4}-(?:(?:0[13578]|1[02])-(?:0[1-9]|[12]\\d|3[01])|(?:0[469]|11)-(?:0[1-9]|[12]\\d|30)|(?:02)-(?:0[1-9]|1\\d|2[0-8])))T(?:(?:[01]\\d|2[0-3]):[0-5]\\d:[0-5]\\d(?:\\.\\d+)?(?:Z))$"
              },
              "actor": {
                "type": "string",
                "enum": [
                  "parent",
                  "child"
                ]
              },
              "payloadHash": {
                "type": "string",
                "pattern": "^sha256:[a-f0-9]{64}$"
              },
              "kind": {
                "type": "string",
                "const": "parent_acceptance"
              },
              "outputHash": {
                "type": "string",
                "pattern": "^sha256:[a-f0-9]{64}$"
              },
              "decision": {
                "type": "string",
                "enum": [
                  "accepted",
                  "rejected"
                ]
              },
              "integrationHash": {
                "anyOf": [
                  {
                    "type": "string",
                    "pattern": "^sha256:[a-f0-9]{64}$"
                  },
                  {
                    "type": "null"
                  }
                ]
              }
            },
            "required": [
              "eventId",
              "at",
              "actor",
              "payloadHash",
              "kind",
              "outputHash",
              "decision",
              "integrationHash"
            ],
            "additionalProperties": false
          }
        ]
      }
    },
    "schema": {
      "type": "string",
      "const": "dharma.codex-native-factory-capture/v1"
    },
    "scopeHash": {
      "type": "string",
      "pattern": "^sha256:[a-f0-9]{64}$"
    },
    "eventsHash": {
      "type": "string",
      "pattern": "^sha256:[a-f0-9]{64}$"
    },
    "captureHash": {
      "type": "string",
      "pattern": "^sha256:[a-f0-9]{64}$"
    },
    "state": {
      "type": "string",
      "enum": [
        "running",
        "output_ready",
        "accepted",
        "rejected"
      ]
    },
    "integrationState": {
      "type": "string",
      "enum": [
        "not_reported",
        "parent_reported"
      ]
    },
    "coverage": {
      "type": "string",
      "const": "partial"
    },
    "authority": {
      "type": "string",
      "const": "evidence_only"
    },
    "fabricTaskId": {
      "type": "null"
    },
    "serverAcknowledgement": {
      "type": "null"
    },
    "acceptedLearningObservation": {
      "type": "boolean",
      "const": false
    },
    "budgetEnforcement": {
      "type": "string",
      "const": "not_attested"
    },
    "limitations": {
      "minItems": 5,
      "maxItems": 5,
      "type": "array",
      "items": {
        "type": "string",
        "enum": [
          "caller_supplied_native_metadata",
          "scope_enforcement_unattested",
          "budget_enforcement_unattested",
          "fabric_ingestion_unqualified",
          "native_turn_capture_unavailable"
        ]
      }
    }
  },
  "required": [
    "factoryTaskId",
    "parentThreadId",
    "parentTurnId",
    "childThreadId",
    "organizationId",
    "workspace",
    "instructionHash",
    "scope",
    "events",
    "schema",
    "scopeHash",
    "eventsHash",
    "captureHash",
    "state",
    "integrationState",
    "coverage",
    "authority",
    "fabricTaskId",
    "serverAcknowledgement",
    "acceptedLearningObservation",
    "budgetEnforcement",
    "limitations"
  ],
  "additionalProperties": false,
  "$id": "https://schemas.dharma-ai.io/codex-native-factory-capture/v1"
}
