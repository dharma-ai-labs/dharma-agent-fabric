{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://schemas.dharma-ai.io/setup-claim-failure/v1",
  "title": "Local setup claim failure phase (not a readiness or retry receipt)",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema", "code", "phase"],
  "properties": {
    "schema": { "const": "dharma.setup-claim-failure/v1" },
    "code": { "const": "setup_claim_failed" },
    "phase": {
      "enum": ["input_validation", "store_preflight", "identity", "challenge", "signing", "finalize", "recipient_approval", "credential_validation", "credential_commit"]
    },
    "reason": { "enum": ["approval_expired", "server_rejected", "network_unavailable", "response_invalid", "canceled"] },
    "serverCode": { "enum": ["setup_claim_approval_unavailable", "setup_claim_client_unavailable", "setup_claim_consume_unavailable", "setup_claim_credentials_unavailable", "setup_claim_device_mismatch", "setup_claim_expired", "setup_claim_proof_invalid", "setup_claim_recipient_required", "setup_claim_scope_unavailable", "setup_claim_unavailable", "agent_fabric_capability_disabled", "agent_fabric_decisions_not_ready", "agent_fabric_not_enabled", "agent_fabric_retention_not_ready", "agent_fabric_signing_expired", "agent_fabric_signing_not_ready", "agent_fabric_signing_rotation_required", "internal_error", "invalid_request", "rate_limit_exceeded", "rate_limit_unavailable", "rate_limited"] },
    "correlationId": { "type": "string", "pattern": "^[0-9a-f]{8}-[0-9a-f]{4}-[1-8][0-9a-f]{3}-[89ab][0-9a-f]{3}-[0-9a-f]{12}$" }
  }
}
