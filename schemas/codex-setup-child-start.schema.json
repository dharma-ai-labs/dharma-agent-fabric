{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://schemas.dharma-ai.io/codex-setup-child-start/v1",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema", "operationId", "intentDigest"],
  "properties": {
    "schema": {"const": "dharma.codex-setup-child-start/v1"},
    "operationId": {"type": "string", "pattern": "^[0-9a-f]{8}-[0-9a-f]{4}-[1-8][0-9a-f]{3}-[89ab][0-9a-f]{3}-[0-9a-f]{12}$(?![\\s\\S])"},
    "intentDigest": {"type": "string", "pattern": "^sha256:[a-f0-9]{64}$(?![\\s\\S])"}
  }
}
