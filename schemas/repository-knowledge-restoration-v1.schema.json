{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://schemas.dharma-ai.io/repository-knowledge-restoration/v1",
  "title": "Candidate-only Repository Knowledge Restoration Reference",
  "description": "Metadata from a currently usable prior signed release, returned only after current same-repository device and source-policy authorization. This is not installation or reactivation authority. A fresh candidate must independently pass current-head, evaluation, signing and activation gates.",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema", "authority", "envelope", "catalogBase64", "manifestBase64"],
  "properties": {
    "schema": { "const": "dharma.repository-knowledge-restoration/v1" },
    "authority": { "const": "candidate_reference_only" },
    "envelope": { "$ref": "https://schemas.dharma-ai.io/repository-package-envelope/v1" },
    "catalogBase64": { "type": "string", "minLength": 4, "maxLength": 349528, "pattern": "^(?:[A-Za-z0-9+/]{4})*(?:[A-Za-z0-9+/]{2}==|[A-Za-z0-9+/]{3}=)?$(?![\\s\\S])" },
    "manifestBase64": { "type": "string", "minLength": 4, "maxLength": 349528, "pattern": "^(?:[A-Za-z0-9+/]{4})*(?:[A-Za-z0-9+/]{2}==|[A-Za-z0-9+/]{3}=)?$(?![\\s\\S])" }
  }
}
