{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://schemas.dharma-ai.io/provider-session-rejected-question/v1",
  "title": "Local deterministic pre-dispatch question rejection",
  "type": "object", "additionalProperties": false,
  "required": ["schema", "organizationId", "repositoryBindingId", "membershipId", "deviceId", "workspaceId", "endpointId", "bindingId", "questionId", "taskId", "recordedAt", "expiresAt", "code", "providerDispatched", "acceptedLearningObservation"],
  "properties": {
    "schema": { "const": "dharma.provider-session-rejected-question/v1" },
    "organizationId": { "type": "string", "pattern": "^[A-Za-z0-9][A-Za-z0-9_-]{0,199}$" },
    "repositoryBindingId": { "type": "string", "format": "uuid" },
    "membershipId": { "type": "string", "format": "uuid" },
    "deviceId": { "type": "string", "format": "uuid" },
    "workspaceId": { "type": "string", "format": "uuid" },
    "endpointId": { "type": "string", "format": "uuid" },
    "bindingId": { "type": "string", "format": "uuid" },
    "questionId": { "type": "string", "format": "uuid" },
    "taskId": { "type": "string", "format": "uuid" },
    "recordedAt": { "type": "string", "format": "date-time" },
    "expiresAt": { "type": "string", "format": "date-time" },
    "code": { "enum": ["named_session_repository_context_limit", "named_session_repository_context_invalid", "codex_session_repository_context_invalid"] },
    "providerDispatched": { "const": false },
    "acceptedLearningObservation": { "const": false }
  }
}
