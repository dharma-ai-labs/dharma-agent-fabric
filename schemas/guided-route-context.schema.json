{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://schemas.dharma-ai.io/guided-route-context/v1",
  "title": "Candidate signed guided route context; never enrollment authority",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema", "contextId", "organizationId", "recipientMembershipId", "hqOrigin", "membershipStatus", "roleRevision", "roleName", "policyRevision", "provider", "clientPlatform", "clientTransport", "sessionId", "deviceId", "issuedAt", "expiresAt", "allowedModes", "bindings", "signature"],
  "properties": {
    "schema": { "const": "dharma.guided-route-context/v1" },
    "contextId": { "type": "string", "format": "uuid" },
    "organizationId": { "type": "string", "pattern": "^org_[A-Za-z0-9_]{1,120}$" },
    "recipientMembershipId": { "type": "string", "format": "uuid" },
    "hqOrigin": { "type": "string", "format": "uri", "maxLength": 256 },
    "membershipStatus": { "const": "active" },
    "roleRevision": { "type": "integer", "minimum": 1, "maximum": 2147483647 },
    "roleName": { "type": "string", "minLength": 1, "maxLength": 80 },
    "policyRevision": { "type": "string", "minLength": 1, "maxLength": 160 },
    "provider": { "const": "codex" },
    "clientPlatform": { "const": "linux" },
    "clientTransport": { "const": "named_session" },
    "sessionId": { "type": "string", "minLength": 1, "maxLength": 160 },
    "deviceId": { "anyOf": [{ "type": "null" }, { "type": "string", "format": "uuid" }] },
    "issuedAt": { "type": "string", "format": "date-time" },
    "expiresAt": { "type": "string", "format": "date-time" },
    "allowedModes": { "type": "array", "minItems": 1, "maxItems": 2, "uniqueItems": true, "items": { "enum": ["source_connected", "knowledge_only"] } },
    "bindings": {
      "type": "array", "minItems": 1, "maxItems": 16,
      "items": {
        "type": "object", "additionalProperties": false,
        "required": ["id", "sourceFingerprint", "packageState", "manifestHash", "catalogHash"],
        "properties": {
          "id": { "type": "string", "format": "uuid" },
          "sourceFingerprint": { "type": "string", "pattern": "^sha256:[a-f0-9]{64}$" },
          "packageState": { "const": "published" },
          "manifestHash": { "type": "string", "pattern": "^sha256:[a-f0-9]{64}$" },
          "catalogHash": { "type": "string", "pattern": "^sha256:[a-f0-9]{64}$" }
        }
      }
    },
    "signature": { "type": "string", "pattern": "^[A-Za-z0-9_-]{86}$" }
  }
}
