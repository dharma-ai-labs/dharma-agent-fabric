    {"name": "fabric_run_analysis", "mode": "paid_write", "backendScope": "evals:run", "confirmation": true},
    {"name": "fabric_release_skill", "mode": "write", "backendScope": "skills:write", "confirmation": true},
    {"name": "fabric_rollout_skill", "mode": "destructive_write", "backendScope": "skills:write", "confirmation": true}
