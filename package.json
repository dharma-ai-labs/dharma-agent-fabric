{
  "name": "dharma-agent-fabric",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "workspaces": [
    "packages/*",
    "apps/*"
  ],
  "engines": {
    "node": ">=22.20.0 <25.0.0",
    "npm": ">=10.9.3 <12.0.0"
  },
  "packageManager": "npm@10.9.3",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/dharma-ai-labs/dharma-agent-fabric.git"
  },
  "scripts": {
    "build": "tsc -b && node scripts/copy-cli-schemas.mjs",
    "clean": "tsc -b --clean",
    "lint": "tsc -b --pretty false",
    "schema:validate": "node scripts/validate-schemas.mjs",
    "vendor:verify": "node scripts/verify-better-harness.mjs",
    "smoke:secure-store": "node scripts/smoke-secure-store.mjs",
    "test": "npm run schema:validate && npm run build && npm run test:unit",
    "test:unit": "node scripts/run-workspace-tests.mjs",
    "pack:verify": "node --test scripts/publish-workflow.test.mjs scripts/qualify-artifacts-only.test.mjs scripts/publish-onboarding-release.test.mjs scripts/verify-package-pins.test.mjs scripts/publish-recovery-contracts.test.mjs scripts/publish-device-maintenance.test.mjs scripts/publish-signing-upgrade.test.mjs scripts/publish-security-recovery.test.mjs && node scripts/verify-package.mjs",
    "publish:onboarding": "node scripts/publish-onboarding-release.mjs",
    "publish:recovery-contracts": "node scripts/publish-recovery-contracts.mjs",
    "publish:device-maintenance": "node scripts/publish-device-maintenance.mjs",
    "test:device-maintenance": "node --test scripts/publish-device-maintenance.test.mjs",
    "publish:signing-upgrade": "node scripts/publish-signing-upgrade.mjs",
    "test:signing-upgrade": "node --test scripts/publish-signing-upgrade.test.mjs",
    "publish:security-recovery": "node scripts/publish-security-recovery.mjs",
    "test:security-recovery": "node --test scripts/publish-security-recovery.test.mjs",
    "pack:setup-readiness": "node --test scripts/verify-setup-readiness-package.test.mjs && node scripts/verify-setup-readiness-package.mjs",
    "mcp:catalog:verify": "node --test scripts/mcp-catalog-drift.test.mjs scripts/mcp-catalog-contracts.test.mjs scripts/mcp-snapshot-manifest-assemble.test.mjs scripts/mcp-tools-list-project.test.mjs && node scripts/verify-mcp-catalog.mjs",
    "openapi:verify": "node scripts/verify-agent-fabric-openapi.mjs",
    "load:relay": "npm run build && node scripts/load-relay.mjs",
    "load:relay:live": "npm run build && node scripts/load-live-relay.mjs",
    "load:skill-rollout": "npm run build && node scripts/load-skill-rollout.mjs",
    "proof:large-capture": "npm run build && node scripts/proof-large-capture.mjs",
    "proof:relay": "node scripts/proof-live-relay.mjs",
    "proof:provider": "npm run build && node scripts/proof-provider-task.mjs",
    "public:content:check": "node scripts/check-public-content.mjs",
    "plugin:skills:generate": "node scripts/plugin-skill-parity.mjs --write",
    "plugin:skills:check": "node --test scripts/plugin-skill-parity.test.mjs && node scripts/plugin-skill-parity.mjs",
    "check": "npm run public:content:check && npm run plugin:skills:check && npm run vendor:verify && npm test && npm run pack:verify && npm run pack:setup-readiness && npm run mcp:catalog:verify && npm run openapi:verify"
  },
  "devDependencies": {
    "@apidevtools/swagger-parser": "^12.1.0",
    "@modelcontextprotocol/client": "2.3.1",
    "@types/node": "^22.15.0",
    "ajv": "^8.17.1",
    "ajv-formats": "^3.0.1",
    "typescript": "^5.8.3",
    "yaml": "^2.8.1"
  }
}
